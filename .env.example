# ==========================================
# Mind-Mancer Production Environment Configuration
# ==========================================

# Node.js Express Backend
PORT=3000
NODE_ENV=development # 'development' | 'production' | 'test'
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (Auto-sanitized in logs)
MONGODB_URI=mongodb://127.0.0.1:27017/mindmancer

# Internal Python ML Microservice
ML_SERVICE_URL=http://127.0.0.1:8000

# Game Engine Tunables (FROZEN PHASE 5C)
GUESS_MIN_SCORE=0.65
GUESS_MIN_MARGIN=0.30
MAX_QUESTIONS=20

# Session & Abuse Protection (Phase 7)
SESSION_MAX_COUNT=5000
SESSION_TTL_MS=1800000
RATE_LIMIT_ENABLED=false # Set to true in production

# Frontend Client (Vite)
VITE_API_BASE_URL=http://localhost:3000

# Python ML Microservice (FastAPI/Uvicorn)
ML_HOST=0.0.0.0
ML_PORT=8000
DATABASE_NAME=mindmancer
